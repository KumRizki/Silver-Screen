---
import Base from '../layouts/Base.astro';
---
<Base title="Not found">
  <section class="wrap page-head">
    <div>
      <h1 class="t-h1">This reel is missing.</h1>
      <p class="t-lead" style="margin-top: 12px">The page you asked for isn't here. It may have moved, or the screening has passed.</p>
    </div>
  </section>
  <div class="wrap">
    <div class="empty">
      <a href="/whats-on" class="btn btn-a">What's On</a>
      <a href="/" class="btn btn-o" style="margin-left: 8px">Home</a>
    </div>
  </div>
</Base>
