---
import { tone } from '../lib/format';
import { statusLabel, type Listing } from '../lib/data';

interface Props {
  item: Listing;
  when: string; // e.g. "13:00 · Audi 6" or "Thu 26"
  sub?: string;
  large?: boolean;
  i?: number; // position in a group, for a small stagger
}
const { item, when, sub, large = false, i = 0 } = Astro.props;
const label = statusLabel(item.status);
const bg = `background: ${tone(item.title)}`;
---
{large ? (
  <a href={item.href} class="tile reveal">
    <div class:list={['poster lg', { 'has-img': item.posterUrl }]} style={bg}>
      {item.posterUrl && <img src={item.posterUrl} alt="" loading="lazy" decoding="async" onerror="this.parentElement.classList.remove('has-img');this.remove()" />}
      <span class="pt">{item.title}</span>
    </div>
    {item.eventName && <p style="margin: 20px 0 0; font-size: 15px; color: var(--amber-text)">{[item.eventName, item.where].filter(Boolean).join(' · ')}</p>}
    <p class="t-h1" style="margin-top: 8px; font-size: 64px">{item.title}</p>
    {item.meta && <p class="t-meta" style="margin-top: 8px">{item.meta}</p>}
    <div class="times"><span>{item.time}</span>{label && <span class="few">{label}</span>}</div>
  </a>
) : (
  <a href={item.href} class="tile reveal" style={`--i: ${i}${item.status === 'sold_out' ? '; opacity: .55' : ''}`}>
    <div class:list={['poster', { 'has-img': item.posterUrl }]} style={bg}>
      {item.posterUrl && <img src={item.posterUrl} alt="" loading="lazy" decoding="async" onerror="this.parentElement.classList.remove('has-img');this.remove()" />}
      <span class="pt">{item.title}</span>
    </div>
    <p class="tile-when">{when}{label && <> · <span class={item.status === 'few_left' ? 'few' : undefined}>{label}</span></>}</p>
    <p class="t-title">{item.title}</p>
    {sub && <p class="t-small">{sub}</p>}
  </a>
)}
