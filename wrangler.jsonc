// Cloudflare deploy settings. The site is static: `npm run build` writes it to
// ./dist, and Cloudflare serves those files. The name must match the project
// name in the Cloudflare dashboard.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "silver-screen",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
